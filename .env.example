# ====================================
# Variables de Entorno - Backend Django
# ====================================

# Desarrollo local
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production-abc123xyz789
USE_SQLITE=False

# Base de datos PostgreSQL (local / Azure Database for PostgreSQL)
DB_HOST=db
DB_NAME=basketball_db
DB_USER=basketball_user
DB_PASSWORD=basketball_pass_2024
DB_PORT=5432

# Hosts permitidos (separados por coma)
# Para Azure agregar: tu-app.azurewebsites.net
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS - Origenes permitidos (separados por coma)
# Para Azure agregar: https://tu-frontend.azurewebsites.net
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8023,http://localhost:8096

# CSRF Trusted Origins (separados por coma)
# Para Azure agregar: https://tu-frontend.azurewebsites.net,https://tu-backend.azurewebsites.net
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8023,http://localhost:8096

# Microservicio de usuarios (Spring Boot)
USER_MODULE_URL=http://host.docker.internal:8096
USER_MODULE_ADMIN_EMAIL=admin@admin.com
USER_MODULE_ADMIN_PASSWORD=12345678

# ====================================
# Ejemplo para Azure App Service:
# ====================================
# DEBUG=False
# SECRET_KEY=<generar-una-clave-segura-con-python-secrets>
# USE_SQLITE=False
# DB_HOST=<tu-servidor>.postgres.database.azure.com
# DB_NAME=basketball_db
# DB_USER=<tu-usuario>
# DB_PASSWORD=<tu-password-seguro>
# DB_PORT=5432
# ALLOWED_HOSTS=tu-backend.azurewebsites.net,localhost
# CORS_ALLOWED_ORIGINS=https://tu-frontend.azurewebsites.net
# CSRF_TRUSTED_ORIGINS=https://tu-frontend.azurewebsites.net,https://tu-backend.azurewebsites.net
# USER_MODULE_URL=https://tu-microservicio.azurewebsites.net
